# Dự án Supabase: POPULATION
# Dùng khi đóng gói bản chạy trên dự án population.
#
# Cách dùng:  cp .env.population.example .env.local   rồi điền khóa
# Đổi file .env.local là đổi dự án — không phải sửa dòng code nào.

SUPABASE_URL=https://feuakoaglemujpwsspie.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://feuakoaglemujpwsspie.supabase.co

# Lấy ở Supabase → Project Settings → API
# Hoặc lấy nhanh từ .env.population.local nếu máy này đã có (file đó không nằm
# trong git, đã có đủ cả hai khóa và đã kiểm là dùng được).
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Bắt buộc tài khoản phải được duyệt (profiles.is_active = true) mới dùng được.
# Chỉ bật SAU KHI đã chạy sql/duyet-tai-khoan.sql, nếu không sẽ tự khóa mình.
REQUIRE_ACTIVE_PROFILE=true
