# Dự án Supabase: HANGGON
# Dùng khi chạy cho Công an phường Hàng Gòn.
#
# Cách dùng:  cp .env.hanggon.example .env.local   rồi điền khóa
# Đổi file .env.local là đổi dự án — không phải sửa dòng code nào.

SUPABASE_URL=https://cppilyhbusukcmrwpvfc.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://cppilyhbusukcmrwpvfc.supabase.co

# Lấy ở Supabase → Project Settings → API
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Bắt buộc tài khoản phải được duyệt (profiles.is_active = true) mới dùng được.
# Chỉ bật SAU KHI đã chạy sql/duyet-tai-khoan.sql, nếu không sẽ tự khóa mình.
REQUIRE_ACTIVE_PROFILE=true
